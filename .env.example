# CineFlow Studio environment configuration (DO NOT commit real secrets)

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to control the bot
# Example: 123456789,987654321
TELEGRAM_AUTHORIZED_USER_IDS=

# Optional secret for local JSON-RPC bridge (127.0.0.1 only, off by default)
CINEFLOW_RPC_SECRET=
